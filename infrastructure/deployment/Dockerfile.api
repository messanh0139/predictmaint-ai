FROM python:3.11-slim

WORKDIR /app

# Installation des dépendances système
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copie des requirements
COPY pipelines/3_inference_ihm/api/requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

# Copie du code de l'API et du module src
COPY pipelines/3_inference_ihm/api/ ./api/
COPY src ./src
COPY storage/ ./storage/

# Variable d'environnement pour le port (Cloud Run utilise PORT=8080)
ENV PORT=8080

# Exposition du port
EXPOSE ${PORT}

# Healthcheck dynamique basé sur la variable PORT
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Commande de démarrage avec port dynamique
CMD uvicorn api.main:app --host 0.0.0.0 --port ${PORT}
