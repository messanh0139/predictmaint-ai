FROM python:3.11-slim

WORKDIR /app

# Installation des dépendances système
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copie des requirements avec contraintes pour reproductibilité
COPY pipelines/3_inference_ihm/api/requirements-api.txt .
COPY constraints-model.txt .
RUN pip install --no-cache-dir -r requirements-api.txt -c constraints-model.txt

# Copie du code de l'API et du module src
COPY pipelines/3_inference_ihm/api/ ./api/
COPY src ./src
COPY storage/ ./storage/

# Création des répertoires nécessaires pour le retraining
RUN mkdir -p /app/storage/processed /app/storage/models/candidates /app/storage/production /app/storage/reference

# Variable d'environnement pour le port (Cloud Run utilise PORT=8080)
ENV PORT=8080

# Exposition du port
EXPOSE 8080

# Note: Cloud Run gère ses propres health checks et ignore les HEALTHCHECK du Dockerfile

# Commande de démarrage avec port dynamique (forme shell pour substitution de variable)
CMD sh -c "uvicorn api.main:app --host 0.0.0.0 --port ${PORT}"
