# Build stage - Construction de l'application React
FROM node:18-alpine AS build

WORKDIR /app

# Copier package.json et installer les dépendances
COPY pipelines/3_inference_ihm/frontend/package.json ./
RUN npm install

# Copier le code source
COPY pipelines/3_inference_ihm/frontend ./

# Build de l'application React
RUN npm run build

# Production stage - Serveur nginx pour servir les fichiers statiques
FROM nginx:alpine

# Copier les fichiers buildés depuis le stage précédent
# Cela inclut automatiquement public/models/*.json et public/data/*.txt
COPY --from=build /app/build /usr/share/nginx/html

# Variable d'environnement pour le port (Cloud Run injecte PORT=8080)
ENV PORT=8080

# Copier le script d'entrée
COPY infrastructure/deployment/docker-entrypoint-dashboard.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 8080

# Note: Cloud Run gère ses propres health checks et ignore les HEALTHCHECK du Dockerfile

CMD ["/docker-entrypoint.sh"]
