# Build stage - Construction de l'application React
FROM node:18-alpine AS build

WORKDIR /app

# Copier package.json et installer les dépendances
COPY pipelines/3_inference_ihm/frontend/package.json ./
RUN npm install

# Copier le code source
COPY pipelines/3_inference_ihm/frontend ./

# Build de l'application React
RUN npm run build

# Production stage - Serveur nginx pour servir les fichiers statiques
FROM nginx:alpine

# Copier les fichiers buildés depuis le stage précédent
COPY --from=build /app/build /usr/share/nginx/html

# Copier les données et métadonnées nécessaires
COPY storage/raw/test_FD001.txt /usr/share/nginx/html/data/raw/test_FD001.txt
COPY storage/models/model_metadata.json /usr/share/nginx/html/models/model_metadata.json
COPY storage/models/test_metrics.json /usr/share/nginx/html/models/test_metrics.json

# Variable d'environnement pour le port (Cloud Run peut utiliser PORT=8080)
ENV PORT=80

# Créer un script d'entrée qui génère la config nginx et injecte les variables runtime
RUN echo '#!/bin/sh\n\
set -e\n\
PORT="${PORT:-80}"\n\
\n\
# Générer la configuration nginx\n\
cat > /etc/nginx/conf.d/default.conf <<EOF\n\
server {\n\
    listen ${PORT};\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    \n\
    # Support de React Router - rediriger toutes les routes vers index.html\n\
    location / {\n\
        try_files \\$uri \\$uri/ /index.html;\n\
    }\n\
    \n\
    # Cache pour les assets statiques\n\
    location /static/ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
    }\n\
    \n\
    # Pas de cache pour index.html\n\
    location = /index.html {\n\
        add_header Cache-Control "no-cache, no-store, must-revalidate";\n\
    }\n\
}\n\
EOF\n\
\n\
# Créer un fichier de configuration runtime pour React\n\
cat > /usr/share/nginx/html/runtime-config.js <<EOF\n\
window.RUNTIME_CONFIG = {\n\
  REACT_APP_API_URL: "${REACT_APP_API_URL:-}",\n\
  REACT_APP_MLFLOW_URL: "${REACT_APP_MLFLOW_URL:-}",\n\
  REACT_APP_GRAFANA_URL: "${REACT_APP_GRAFANA_URL:-}",\n\
  REACT_APP_API_DOCS_URL: "${REACT_APP_API_URL:-}/docs",\n\
  REACT_APP_DATA_PATH: "/data/raw/test_FD001.txt",\n\
  REACT_APP_METADATA_PATH: "/models/model_metadata.json",\n\
  REACT_APP_METRICS_PATH: "/models/test_metrics.json"\n\
};\n\
EOF\n\
\n\
echo "Starting nginx on port ${PORT}"\n\
echo "API URL: ${REACT_APP_API_URL:-not set}"\n\
echo "MLflow URL: ${REACT_APP_MLFLOW_URL:-not set}"\n\
echo "Grafana URL: ${REACT_APP_GRAFANA_URL:-not set}"\n\
exec nginx -g "daemon off;"\n\
' > /docker-entrypoint.sh && chmod +x /docker-entrypoint.sh

EXPOSE ${PORT}

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:${PORT}/ || exit 1

CMD ["/docker-entrypoint.sh"]
