# Build stage - Construction de l'application React
FROM node:18-alpine AS build

WORKDIR /app

# Copier package.json et installer les dépendances
COPY pipelines/3_inference_ihm/frontend/package.json ./
RUN npm install

# Copier le code source
COPY pipelines/3_inference_ihm/frontend ./

# Build de l'application React
RUN npm run build

# Production stage - Serveur nginx pour servir les fichiers statiques
FROM nginx:alpine

# Copier les fichiers buildés depuis le stage précédent
COPY --from=build /app/build /usr/share/nginx/html

# Copier les données et métadonnées nécessaires
COPY storage/raw/test_FD001.txt /usr/share/nginx/html/data/raw/test_FD001.txt
COPY storage/models/model_metadata.json /usr/share/nginx/html/models/model_metadata.json
COPY storage/models/test_metrics.json /usr/share/nginx/html/models/test_metrics.json

# Configuration nginx personnalisée pour React Router
RUN echo 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
    \n\
    # Support de React Router - rediriger toutes les routes vers index.html\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
    \n\
    # Cache pour les assets statiques\n\
    location /static/ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
    }\n\
    \n\
    # Pas de cache pour index.html\n\
    location = /index.html {\n\
        add_header Cache-Control "no-cache, no-store, must-revalidate";\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
