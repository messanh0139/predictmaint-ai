FROM prom/prometheus:v3.5.0 AS promsrc

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --uid 10001 prometheus

COPY --from=promsrc /bin/prometheus /usr/local/bin/prometheus
COPY monitoring/prometheus/prometheus.cloudrun.yml.template /etc/prometheus/prometheus.yml.template
COPY infra/gcp/prometheus-entrypoint.sh /entrypoint.sh

RUN mkdir -p /prometheus \
    && chmod +x /entrypoint.sh \
    && chown -R prometheus:prometheus /prometheus /etc/prometheus

USER 10001

EXPOSE 9090
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=6 \
  CMD curl -sf "http://127.0.0.1:${PORT:-9090}/-/healthy" || exit 1

ENTRYPOINT ["/entrypoint.sh"]
